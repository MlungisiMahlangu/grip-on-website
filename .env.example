# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Resend (order notifications), optional. Without a key, orders still place
# and the server logs that emails were skipped.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Defaults to Resend's test sender.
RESEND_FROM_EMAIL=
OWNER_EMAIL=owner@your-domain.co.za
# Optional: auth login to promote to admin. Falls back to OWNER_EMAIL,
# then to the only auth user if the project has exactly one.
ADMIN_EMAIL=

NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional. When set, /api/keep-alive requires the header
# "Authorization: Bearer <token>". Use the same value in the scheduled ping.
KEEP_ALIVE_TOKEN=
